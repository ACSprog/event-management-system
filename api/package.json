{
  "name": "ems-api",
  "private": true,
  "description": "Event Management System backend (NestJS). Talks to PostgreSQL with row-level security.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "12.6.1",
    "@nestjs/core": "12.6.1",
    "@nestjs/platform-express": "12.6.1",
    "@nestjs/throttler": "6.8.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.7",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
